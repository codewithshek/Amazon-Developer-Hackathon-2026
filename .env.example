# ── HearthGuard runtime ─────────────────────────────────────────────
# Every live integration is optional. With no credentials the app runs
# a deterministic, signed local replay so judges can evaluate it offline.

PORT=4000
DEMO_MODE=true

# Ring Partner API (webhook + WHEP). Live calls require partner access.
RING_WEBHOOK_SECRET=local_development_secret_change_me
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_TOKEN=

# Bee wearable proxy (`bee proxy` serves http://127.0.0.1:8787)
BEE_PROXY_URL=http://127.0.0.1:8787/v1/facts

# AWS Bedrock — if absent, HearthGuard uses the recorded reasoning trace.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Origin allowed to call the local MCP server from a browser.
MCP_ALLOWED_ORIGIN=http://localhost:5173
